# siphonophore-core -- scoped privilege-separation grant.
#
# Install (never edit /etc/sudoers.d/ files directly with a plain editor -- visudo validates
# syntax before saving, a broken sudoers file can lock out sudo entirely):
#
#   sudo visudo -f /etc/sudoers.d/siphonophore-core
#   # paste the Cmnd_Alias/grant lines below, with <BROKER_USER> and <REPO_PATH> replaced
#
# or, non-interactively (still validate afterward):
#
#   sudo cp scripts/siphonophore-sudoers.template /etc/sudoers.d/siphonophore-core
#   sudo sed -i 's|<REPO_PATH>|/actual/path/to/siphonophore|; s|<BROKER_USER>|actualuser|' \
#       /etc/sudoers.d/siphonophore-core
#   sudo chmod 440 /etc/sudoers.d/siphonophore-core
#   sudo visudo -c
#
# Grants NOPASSWD access to exactly the two helper scripts, nothing else -- deliberately not
# "ALL", matching warden's own PART-B-POPOS-RUNBOOK.md section R2 pattern.
#
# Replace:
#   <BROKER_USER>  the unprivileged user the siphonophore broker process actually runs as
#   <REPO_PATH>    absolute path to this checkout (or wherever the two scripts are installed --
#                  they don't have to live inside the repo, this is just the default layout)

Cmnd_Alias SIPHONOPHORE_CORE = <REPO_PATH>/scripts/siphonophore-useradd, <REPO_PATH>/scripts/siphonophore-userdel
<BROKER_USER> ALL=(root) NOPASSWD: SIPHONOPHORE_CORE

# siphonophore-spawn (contracts/spawn_helper.md, SH-08): a SEPARATE Cmnd_Alias, deliberately, not
# folded into SIPHONOPHORE_CORE above -- SH-08 requires this one be invocable with NO arguments at
# all, which sudoers expresses with the trailing "" (an empty string immediately after the command
# path means "this command may be run with no arguments," not "any arguments"; a bare path with
# nothing after it means the opposite -- any arguments allowed). Verify this actually behaves that
# way on your sudo version with `sudo -l` before trusting it; sudoers argument-matching syntax has
# had real version-to-version differences and this project's own discipline is to validate claims
# like this for real, not assume them from documentation.
#
# Installed path, not a repo-relative one: SH-26 requires the helper binary be root-owned and not
# writable by <BROKER_USER> -- `make -C spawn_helper install` (run as root) installs it to
# /usr/local/libexec/siphonophore-spawn with mode 0711, root:root. Do not grant sudo on a
# repo-checkout copy of this binary; the checkout is typically owned by a non-root deploy/dev user,
# which would let that user replace the "privileged" binary sudo executes.
Cmnd_Alias SIPHONOPHORE_SPAWN = /usr/local/libexec/siphonophore-spawn ""
<BROKER_USER> ALL=(root) NOPASSWD: SIPHONOPHORE_SPAWN
